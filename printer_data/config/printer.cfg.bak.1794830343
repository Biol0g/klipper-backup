# Voron Switchwire • Hybrid CoreXZ IDEX • Klipper
# T0 = lewa karetka z Eddy, T1 = prawa karetka. Jedyny plik .cfg drukarki.
# Najpierw zainstaluj klippy/extras/switchwire_idex.py i przeczytaj URUCHOMIENIE.md.
# Wymiary w mm, prędkości w mm/s, chyba że podano inaczej.

[mcu]
serial: /dev/serial/by-id/usb-Klipper_stm32h723xx_390025000951313339373836-if00
restart_method: command

[mcu ebb]
serial: /dev/serial/by-id/usb-Klipper_stm32g0b1xx_0C00150010504D5930313920-if00

[mcu ebb_t1]
serial: /dev/serial/by-id/usb-Klipper_stm32g0b1xx_40004E000E504D4D35313220-if00

[printer]
kinematics: hybrid_corexz
max_velocity: 150
max_accel: 3000
max_z_velocity: 15
max_z_accel: 150
square_corner_velocity: 5.0

# Napędy • 2 niezależne X, wspólne Y stołu i Z bramy.

[stepper_x]
step_pin: PG0
dir_pin: !PG1
enable_pin: !PF15
microsteps: 16
rotation_distance: 40
endstop_pin: ^PG15
position_endstop: -22.5
position_min: -22.5
position_max: 170
homing_speed: 50

[tmc2209 stepper_x]
uart_pin: PD11
run_current: 0.9
hold_current: 0.7

[dual_carriage]
axis: x
step_pin: PF13
dir_pin: !PF12
enable_pin: !PF14
microsteps: 16
rotation_distance: 40
endstop_pin: ^PG12
position_endstop: 249
position_min: 55
position_max: 249
homing_speed: 50
homing_positive_dir: true
safe_distance: 65

[tmc2209 dual_carriage]
uart_pin: PC4
run_current: 0.9
hold_current: 0.7

[stepper_y]
step_pin: PF11
dir_pin: PG3
enable_pin: !PG5
microsteps: 16
endstop_pin: tmc2209_stepper_y:virtual_endstop
rotation_distance: 40
position_endstop: -24.5
position_min: -24.5
position_max: 195
homing_speed: 50
homing_retract_dist: 0

[tmc2209 stepper_y]
uart_pin: PC6
run_current: 1.1
diag_pin: ^PG10
driver_SGTHRS: 50
stealthchop_threshold: 0

[stepper_z]
step_pin: PG4
dir_pin: PC1
enable_pin: !PA2
microsteps: 16
rotation_distance: 40
endstop_pin: probe:z_virtual_endstop
position_min: -1
position_max: 210
homing_speed: 5
homing_retract_dist: 0

[tmc2209 stepper_z]
uart_pin: PC7
run_current: 0.9
hold_current: 0.7

[stepper_z1]
step_pin: PE6
dir_pin: !PA14
enable_pin: !PE0
microsteps: 16
rotation_distance: 40

[tmc2209 stepper_z1]
uart_pin: PD3
run_current: 0.9
hold_current: 0.7

# Narzędzia • PID z poprzedniego SAVE_CONFIG. Limity ekstruzji wg Klippera.

[extruder]
step_pin: ebb:PD0
dir_pin: ebb:PD1
enable_pin: !ebb:PD2
microsteps: 16
rotation_distance: 22
nozzle_diameter: 0.400
filament_diameter: 1.750
gear_ratio: 50:10
heater_pin: ebb:PB13
sensor_type: ATC Semitec 104NT-4-R025H42G
sensor_pin: ebb:PA3
min_temp: 0
max_temp: 300
min_extrude_temp: 170
control: pid
pid_Kp: 31.132
pid_Ki: 9.023
pid_Kd: 26.853

[tmc2209 extruder]
uart_pin: ebb:PA15
interpolate: false
run_current: 0.65
sense_resistor: 0.110

[fan_generic part_t0]
pin: ebb:PA1
max_power: 1.0
kick_start_time: 0.5
shutdown_speed: 0.0

[heater_fan hotend_fan]
pin: ebb:PA0
heater: extruder
max_power: 1.0
kick_start_time: 0.5
fan_speed: 1.0
shutdown_speed: 1.0
off_below: 0.5

[neopixel sb_leds_t0]
pin: ebb:PD3
chain_count: 3
color_order: GRB

[extruder1]
step_pin: ebb_t1:PD0
dir_pin: ebb_t1:PD1
enable_pin: !ebb_t1:PD2
microsteps: 16
rotation_distance: 22
nozzle_diameter: 0.400
filament_diameter: 1.750
gear_ratio: 50:10
heater_pin: ebb_t1:PB13
sensor_type: ATC Semitec 104NT-4-R025H42G
sensor_pin: ebb_t1:PA3
min_temp: 0
max_temp: 300
min_extrude_temp: 170
control: pid
pid_Kp: 30.712
pid_Ki: 9.306
pid_Kd: 25.339

[tmc2209 extruder1]
uart_pin: ebb_t1:PA15
interpolate: false
run_current: 0.65
sense_resistor: 0.110

[fan_generic part_t1]
pin: ebb_t1:PA1
max_power: 1.0
kick_start_time: 0.5
shutdown_speed: 0.0

[heater_fan hotend_fan_t1]
pin: ebb_t1:PA0
heater: extruder1
max_power: 1.0
kick_start_time: 0.5
fan_speed: 1.0
shutdown_speed: 1.0
off_below: 0.5

[neopixel sb_leds_t1]
pin: ebb_t1:PD3
chain_count: 3
color_order: GRB

# Stół, chłodzenie elektroniki i temperatury płyt.

[heater_bed]
heater_pin: PA1
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PF3
control: pid
pid_Kp: 71.521
pid_Ki: 1.166
pid_Kd: 1096.952
min_temp: 0
max_temp: 130

[controller_fan electronics_fan]
pin: PA8
max_power: 1.0
kick_start_time: 0.5
idle_timeout: 60

[controller_fan electronics_fan1]
pin: PE5
max_power: 1.0
kick_start_time: 0.5
idle_timeout: 60

[temperature_sensor Plyta_glowna]
sensor_type: temperature_mcu
sensor_mcu: mcu

[temperature_sensor EBB_T0]
sensor_type: temperature_mcu
sensor_mcu: ebb

[temperature_sensor EBB_T1]
sensor_type: temperature_mcu
sensor_mcu: ebb_t1

[temperature_sensor Host_Klippera]
sensor_type: temperature_host

# Eddy na T0 • obszar mesh opisuje położenie sondy.

[probe_eddy_current btt_eddy]
sensor_type: ldc1612
i2c_mcu: ebb
i2c_software_scl_pin: ebb:PB3
i2c_software_sda_pin: ebb:PB4
x_offset: 0
y_offset: 10
z_offset: 0.5
speed: 10
samples: 3
samples_result: median
samples_tolerance: 0.04
samples_tolerance_retries: 3

[bed_mesh]
speed: 100
horizontal_move_z: 3
mesh_min: 10, 18
mesh_max: 165, 151
probe_count: 5, 5
algorithm: bicubic
adaptive_margin: 2

[virtual_sdcard]
path: ~/printer_data/gcodes
on_error_gcode: IDEX_ABORT

[pause_resume]
recover_velocity: 35

# Grawitacyjna brama: przy bezczynności wyłącz grzałki, pozostaw napędy.
# Przed ręcznym M84 / odcięciem zasilania podeprzyj bramę.
[idle_timeout]
timeout: 600
gcode:
    TURN_OFF_HEATERS
    M107

[display_status]

[respond]

[exclude_object]

[gcode_arcs]
resolution: 0.1

# Dwa wejścia na głowicę. Zdarzenia rozstrzyga Python według aktywnej karetki.

[filament_switch_sensor t0_entry]
switch_pin: ^ebb:PB8
pause_on_runout: False
runout_gcode: _IDEX_RUNOUT TOOL=0 SENSOR=entry

[filament_switch_sensor t0_hotend]
switch_pin: ^ebb:PB6
pause_on_runout: False
runout_gcode: _IDEX_RUNOUT TOOL=0 SENSOR=hotend

[filament_switch_sensor t1_entry]
switch_pin: ^ebb_t1:PB8
pause_on_runout: False
runout_gcode: _IDEX_RUNOUT TOOL=1 SENSOR=entry

[filament_switch_sensor t1_hotend]
switch_pin: ^ebb_t1:PB6
pause_on_runout: False
runout_gcode: _IDEX_RUNOUT TOOL=1 SENSOR=hotend

# Współrzędne parkowania są maszynowe. Sprawdź dysze, wentylatory i przewody.
[switchwire_idex]
park_x: -21.5, 248
home_xy: 100, 85
travel_speed: 55
lift_speed: 6
lift: 3
home_clearance: 5
# Korekcje prawej głowicy, konwencja SET_GCODE_OFFSET. Ustal na swojej maszynie.
offset_x: 0.0
offset_y: 0.0
offset_z: 0.0
# Odcinek rezerwowany tylko przy PURGE=1, w układzie modelu.
purge_x: 75
purge_y: 20
purge_length: 35
purge_height: 0.32
purge_filament: 2.0

# Adaptery do poleceń Klippera. Sekwencje i odczyty stanu są w Pythonie.
[gcode_macro G28]
rename_existing: G28.1
gcode:
    IDEX_HOME X={1 if 'X' in params else 0} Y={1 if 'Y' in params else 0} Z={1 if 'Z' in params else 0}

[gcode_macro PAUSE]
rename_existing: PAUSE_BASE
gcode:
    IDEX_PAUSE

[gcode_macro RESUME]
rename_existing: RESUME_BASE
gcode:
    IDEX_RESUME {rawparams}

[gcode_macro CANCEL_PRINT]
rename_existing: CANCEL_PRINT_BASE
gcode:
    IDEX_CANCEL

[gcode_macro BED_MESH_CALIBRATE]
rename_existing: BED_MESH_CALIBRATE_BASE
gcode:
    _IDEX_REQUIRE_PROBE
    BED_MESH_CALIBRATE_BASE {rawparams}

[gcode_macro PROBE]
rename_existing: PROBE_BASE
gcode:
    _IDEX_REQUIRE_PROBE
    PROBE_BASE {rawparams}

[gcode_macro PROBE_ACCURACY]
rename_existing: PROBE_ACCURACY_BASE
gcode:
    _IDEX_REQUIRE_PROBE
    PROBE_ACCURACY_BASE {rawparams}

# Opcjonalny klient kTAMV po instalacji programu i kamery. Tylko jedna sekcja.
# [ktamv]
# nozzle_cam_url: http://localhost/webcam2/snapshot?max_delay=0
# server_url: http://localhost:8085
# move_speed: 600
# send_frame_to_cloud: false
# detection_tolerance: 0

